# Local-only staging-style env for running the governed stack in this workspace.
CONTROL_PLANE_BASE_URL=http://127.0.0.1:3000
CONTROL_PLANE_GOVERNANCE_MODE=live
CONTROL_PLANE_ENVIRONMENT_MODE=staging
CONTROL_PLANE_DEFAULT_TENANT_ID=tenant-stage
CONTROL_PLANE_ONYX_SECRET_PATH=secret/data/runtime/tenant-stage/onyx
CONTROL_PLANE_ONYX_SECRET_KEY=api_token
CONTROL_PLANE_REQUIRED_SECRET_PATH=secret/data/runtime/tenant-stage/governed-flow
CONTROL_PLANE_REQUIRED_SECRET_KEY=api_token
CONTROL_PLANE_KEYCLOAK_REALM=umbrella
CONTROL_PLANE_OPA_PACKAGE=umbrella/policy/decision
CONTROL_PLANE_QDRANT_COLLECTION=governed_docs
CONTROL_PLANE_ONYX_PORT=3010

# Keycloak
KEYCLOAK_REALM=umbrella
KEYCLOAK_HOSTNAME=127.0.0.1
KEYCLOAK_HOST_PORT=18080
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=local-keycloak-admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=local-keycloak-db

# Governed live smoke principal
LIVE_USERNAME=governed-live-admin
LIVE_PASSWORD=local-live-password
TENANT_ID=tenant-stage
SMOKE_CLIENT_ID=governed-smoke-client

# Langfuse
LANGFUSE_DATABASE_URL=postgresql://langfuse:local-langfuse-db@db:5432/langfuse
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=local-langfuse-db
LANGFUSE_NEXTAUTH_SECRET=local-langfuse-nextauth
LANGFUSE_SALT=local-langfuse-salt
LANGFUSE_NEXTAUTH_URL=http://127.0.0.1:3002
LANGFUSE_INIT_ORG_ID=org-stage
LANGFUSE_INIT_ORG_NAME=Stage Org
LANGFUSE_INIT_PROJECT_ID=proj-onyx
LANGFUSE_INIT_PROJECT_NAME=Onyx Traces
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=local-langfuse-public
LANGFUSE_INIT_PROJECT_SECRET_KEY=local-langfuse-secret
LANGFUSE_INIT_USER_EMAIL=admin@example.local
LANGFUSE_INIT_USER_NAME=Stage Admin
LANGFUSE_INIT_USER_PASSWORD=local-langfuse-admin

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-admin

# Superset
SUPERSET_SECRET_KEY=local-superset-secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=local-superset-admin
