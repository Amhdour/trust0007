# SECURITY NOTE: production-path placeholders only; replace before running.
CONTROL_PLANE_GOVERNANCE_MODE=live
CONTROL_PLANE_ENVIRONMENT_MODE=staging
CONTROL_PLANE_DEFAULT_TENANT_ID=tenant-stage
CONTROL_PLANE_ONYX_SECRET_PATH=secret/data/runtime/tenant-stage/onyx
CONTROL_PLANE_DIFY_SECRET_PATH=secret/data/runtime/tenant-stage/dify
CONTROL_PLANE_ONYX_SECRET_KEY=api_token
CONTROL_PLANE_REQUIRED_SECRET_PATH=secret/data/runtime/tenant-stage/governed-flow
CONTROL_PLANE_REQUIRED_SECRET_KEY=api_token
CONTROL_PLANE_ALLOW_LOCAL_RUNTIME_TARGETS=true
CONTROL_PLANE_EXTERNAL_REACHABLE=false
CONTROL_PLANE_KEYCLOAK_DEV_MODE=false
CONTROL_PLANE_VAULT_DEV_MODE=false
# Optional browser helper for local/live previews.
# When true, live launch links can route through /auth/live/login first.
CONTROL_PLANE_LIVE_FRONT_DOOR_ENABLED=false
CONTROL_PLANE_KEYCLOAK_REALM=umbrella
CONTROL_PLANE_OPA_PACKAGE=umbrella/policy/decision
CONTROL_PLANE_QDRANT_COLLECTION=governed_docs
CONTROL_PLANE_ONYX_PORT=3010
CONTROL_PLANE_DIFY_PORT=8088
CONTROL_PLANE_ONYX_HOST=127.0.0.1
CONTROL_PLANE_DIFY_HOST=127.0.0.1
# CONTROL_PLANE_ONYX_BASE_URL=http://onyx_runtime:80
# CONTROL_PLANE_DIFY_BASE_URL=http://dify_runtime:80
# CONTROL_PLANE_ONYX_BASE_URL=http://host.docker.internal:3010
# CONTROL_PLANE_DIFY_BASE_URL=http://host.docker.internal:8088

# Keycloak
KEYCLOAK_REALM=umbrella
KEYCLOAK_HOSTNAME_URL=http://localhost:18080
KEYCLOAK_HOST_PORT=18080
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-me

# Governed live smoke principal
LIVE_USERNAME=governed-live-admin
LIVE_PASSWORD=replace-me
TENANT_ID=tenant-stage
SMOKE_CLIENT_ID=governed-smoke-client

# Langfuse
LANGFUSE_DATABASE_URL=postgresql://langfuse:langfuse@db:5432/langfuse
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=replace-me
LANGFUSE_NEXTAUTH_SECRET=replace-me
LANGFUSE_SALT=replace-me
LANGFUSE_NEXTAUTH_URL=http://localhost:3002
LANGFUSE_INIT_ORG_ID=org-stage
LANGFUSE_INIT_ORG_NAME=Stage Org
LANGFUSE_INIT_PROJECT_ID=proj-onyx
LANGFUSE_INIT_PROJECT_NAME=Onyx Traces
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=replace-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=replace-me
LANGFUSE_INIT_USER_EMAIL=admin@example.local
LANGFUSE_INIT_USER_NAME=Stage Admin
LANGFUSE_INIT_USER_PASSWORD=replace-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Superset
SUPERSET_SECRET_KEY=replace-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=replace-me
SUPERSET_HOST_PORT=18488
