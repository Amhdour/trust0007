# Live/staging governed control-plane profile
CONTROL_PLANE_GOVERNANCE_MODE=live
CONTROL_PLANE_ENVIRONMENT_MODE=staging

# Runtime handoff configuration (remote Onyx via forwarded GitHub Codespaces HTTPS URL)
# The forwarded Onyx port must be reachable from this trust0007 Codespace.
# In GitHub Codespaces, set the Onyx forwarded port visibility to Public or Organization.
CONTROL_PLANE_ONYX_BASE_URL=https://your-onyx-codespace-port.app.github.dev
CONTROL_PLANE_ONYX_API_BASE_URL=https://your-onyx-codespace-port.app.github.dev/api
CONTROL_PLANE_USE_LOCAL_ONYX=false
CONTROL_PLANE_ONYX_PORT=3010
CONTROL_PLANE_ONYX_HOST=127.0.0.1
CONTROL_PLANE_ONYX_SECRET_PATH=secret/data/runtime/tenant-stage/onyx
CONTROL_PLANE_RUNTIME_SECRET_KEY=api_token
CONTROL_PLANE_REQUIRED_SECRET_PATH=secret/data/runtime/tenant-stage/governed-flow
CONTROL_PLANE_REQUIRED_SECRET_KEY=api_token

# Live dependencies (must be real values)
CONTROL_PLANE_KEYCLOAK_BASE_URL=http://keycloak:8080
CONTROL_PLANE_KEYCLOAK_REALM=umbrella
CONTROL_PLANE_OPA_URL=http://opa:8181
CONTROL_PLANE_OPA_PACKAGE=umbrella/policy/decision
CONTROL_PLANE_QDRANT_URL=http://qdrant:6333
CONTROL_PLANE_QDRANT_COLLECTION=governed_docs
CONTROL_PLANE_VAULT_ADDR=http://vault:8200
CONTROL_PLANE_VAULT_TOKEN_FILE=/run/control-plane/bootstrap-state/vault-root-token

# Hardening toggles
CONTROL_PLANE_ALLOW_LOCAL_RUNTIME_TARGETS=false
CONTROL_PLANE_EXTERNAL_REACHABLE=true
CONTROL_PLANE_KEYCLOAK_DEV_MODE=false
CONTROL_PLANE_VAULT_DEV_MODE=false
# Optional Codespaces helper: route live launch links through /auth/live/login
# so the browser receives a Keycloak access-token cookie before handoff.
CONTROL_PLANE_LIVE_FRONT_DOOR_ENABLED=true
